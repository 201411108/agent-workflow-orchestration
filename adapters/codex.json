{
  "target": "codex",
  "label": "Codex Adapter",
  "roleFilePattern": "{role}.toml",
  "roleFormat": "toml",
  "orchestratorAs": "skill",
  "skillFilePattern": "{role}/SKILL.md",
  "fileName": "SKILL.md",
  "projectPaths": {
    "rolesDir": ".codex/agents",
    "skillsDir": ".agents/skills",
    "agentsDir": ".codex/agents",
    "configFile": ".codex/config.toml",
    "guidanceFile": "AGENTS.md",
    "specsDir": ".agent-workflow/specs"
  },
  "globalPaths": {
    "rolesDir": ".codex/agents",
    "skillsDir": ".agents/skills",
    "agentsDir": ".codex/agents",
    "configFile": ".codex/config.toml",
    "guidanceFile": ".codex/AGENTS.md",
    "specsDir": ".agent-workflow/specs"
  },
  "permissions": {
    "none": {
      "sandbox_mode": "read-only"
    },
    "docs-only": {
      "sandbox_mode": "workspace-write"
    },
    "implementation": {
      "sandbox_mode": "workspace-write"
    }
  },
  "legacyRolePaths": [
    {
      "dir": ".agents/skills",
      "pattern": "feature-orchestrator/SKILL.md"
    },
    {
      "dir": ".codex/agents",
      "pattern": "planner.toml"
    },
    {
      "dir": ".codex/agents",
      "pattern": "designer.toml"
    },
    {
      "dir": ".codex/agents",
      "pattern": "developer.toml"
    }
  ],
  "tools": {
    "file_read": null,
    "file_edit": null,
    "glob_search": null,
    "text_search": null,
    "web_search": "web_search",
    "browser": null,
    "lint_runner": null,
    "test_runner": null,
    "structured_question": null
  },
  "skillGrant": null,
  "skillsKey": null,
  "toolBindingNote": "Codex는 역할별 도구 허용 목록을 지원하지 않는다. 쓰기 권한은 sandbox_mode로, 웹 검색은 web_search 키로만 제어한다 (HARNESS_CAPABILITIES 2절). 스킬 바인딩도 미지원으로 둔다 — [[skills.config]] 구문은 존재하지만 그것이 범위를 제한하는지 실측하지 않았다. Claude의 skills: 키는 실측 결과 제한이 아니라 진입점이었고 (DESIGN_DECISIONS D14), 구문 존재를 근거로 네이티브라고 판정한 것이 1.1의 오류였다. 같은 오류를 반복하지 않기 위해 측정 전까지 null로 둔다.",
  "writeCapableTools": []
}
